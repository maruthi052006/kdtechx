# KDTechX Full-Stack Django Portal Environment Configuration
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=django-insecure-kdtechx-prod-secret-key-2026-secure
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Database Configuration:
# - Leave blank to use SQLite (zero-config local default)
# - Or paste your Render/Supabase PostgreSQL Database URL (postgresql://user:pass@host:port/dbname)
DATABASE_URL=

# CSRF Trusted Origins (add your Render application domain)
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://localhost:8000,http://127.0.0.1:8000

# Automatic Superuser Provisioning on Deployment (Optional)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=YourSecurePassword123

